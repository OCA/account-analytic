<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Analytic Tag -->
    <record id="account_analytic_tag_dimension_form_view" model="ir.ui.view">
        <field name="name">account.analytic.tag.dimension.form.view</field>
        <field name="model">account.analytic.tag</field>
        <field
            name="inherit_id"
            ref="analytic_tag_dimension.account_analytic_tag_dimension_form_view"
        />
        <field name="arch" type="xml">
            <field name="analytic_dimension_id" position="after">
                <field name="resource_ref" />
            </field>
        </field>
    </record>

    <!-- Analytic Tag Dimension -->
    <record id="account_analytic_dimension_form_view" model="ir.ui.view">
        <field name="name">account.analytic.dimension.form.view</field>
        <field name="model">account.analytic.dimension</field>
        <field
            name="inherit_id"
            ref="analytic_tag_dimension.account_analytic_dimension_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main']" position="inside">
                <field name="required" />
                <label for="by_sequence" />
                <div>
                    <field name="by_sequence" class="oe_inline" />
                    <field
                        name="sequence"
                        class="oe_inline"
                        invisible="not by_sequence"
                    />
                </div>
                <label for="ref_model_id" />
                <div>
                    <field
                        name="ref_model_id"
                        class="oe_inline"
                        options="{'no_open': True, 'no_create_edit': True}"
                    />
                    <button
                        name="create_analytic_tags"
                        string="=> Create Tags"
                        type="object"
                        class="oe_link"
                        invisible="not ref_model_id"
                    />
                </div>
                <field
                    name="filtered_field_ids"
                    widget="many2many_tags"
                    domain="[('model_id', '=', ref_model_id), ('ttype', '=', 'many2one')]"
                    invisible="not ref_model_id or not by_sequence"
                />
            </xpath>
        </field>
    </record>
    <record id="account_analytic_dimension_list_view" model="ir.ui.view">
        <field name="name">account.analytic.dimension.list.view</field>
        <field name="model">account.analytic.dimension</field>
        <field
            name='inherit_id'
            ref='analytic_tag_dimension.account_analytic_dimension_list_view'
        />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="required" optional="show" />
                <field name="by_sequence" optional="show" />
                <field name="sequence" optional="show" />
            </field>
        </field>
    </record>
</odoo>
