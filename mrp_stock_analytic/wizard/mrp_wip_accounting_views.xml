<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_wip_accounting_form" model="ir.ui.view">
        <field
            name="name"
        >mrp.account.wip.accounting.form.inherit.mrp_stock_analytic</field>
        <field name="model">mrp.account.wip.accounting</field>
        <field name="inherit_id" ref="mrp_account.view_wip_accounting_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='line_ids']//list//field[@name='label']"
                position="after"
            >
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    groups="analytic.group_analytic_accounting"
                />
            </xpath>
        </field>
    </record>
</odoo>
