<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.mrp_stock_analytic</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock_account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="group_lot_on_invoice" position="after">
                <setting
                    id="mrp_analytic_on_finished"
                    string="MRP Analytic on Finished Products"
                    help="Assign analytic distribution to finished product moves."
                >
                    <field name="mrp_analytic_on_finished" />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
