<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="custom_account_analytic_distribution_model_view_list" model="ir.ui.view">
        <field name="name">custom.account.analytic.distribution.model.view.list</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="inherit_id" ref="analytic.account_analytic_distribution_model_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='analytic_distribution']" position="before">
                <field name="team_id" />
            </xpath>
        </field>
    </record>

    <record id="custom_account_analytic_distribution_model_view_form" model="ir.ui.view">
        <field name="name">custom.account.analytic.distribution.model.view.form</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="inherit_id" ref="analytic.account_analytic_distribution_model_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_category_id']" position="after">
                <field name="team_id" />
            </xpath>
        </field>
    </record>
</odoo>
