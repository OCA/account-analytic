<odoo>

    <record id="view_stock_quant_tree_inventory_analytic" model="ir.ui.view">
        <field name="name">stock.quant.inventory.tree.analytic</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    groups="analytic.group_analytic_accounting"
                    options="{'product_field': 'product_id', 'business_domain': 'stock_move'}"
                    optional="show"
                />
            </field>
        </field>
    </record>

    <record id="view_stock_quant_tree_analytic" model="ir.ui.view">
        <field name="name">stock.quant.tree.analytic</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    groups="analytic.group_analytic_accounting"
                    options="{'product_field': 'product_id', 'business_domain': 'stock_move'}"
                    optional="show"
                />
            </field>
        </field>
    </record>

</odoo>
