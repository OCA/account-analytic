<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Re-add account_department_id to analytic line filter view.
         Removed from analytic_base_department to avoid primary view inheritance
         collision with timesheets.analysis.report in hr_timesheet. -->
    <record id="view_account_analytic_line_filter" model="ir.ui.view">
        <field name="name">account.analytic.line.select.department</field>
        <field name="model">account.analytic.line</field>
        <field
            name="inherit_id"
            ref="analytic_base_department.view_account_analytic_line_filter"
        />
        <field name="arch" type="xml">
            <field name="department_id" position="after">
                <field name="account_department_id" />
            </field>
            <filter name="department" position="after">
                <filter
                    name="account_department"
                    string="Account Department"
                    context="{'group_by':'account_department_id'}"
                />
            </filter>
        </field>
    </record>
</odoo>
