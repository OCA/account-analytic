msgid ""
"Analytic policy is set to 'Always' with account '%(account)s' but the "
"analytic account is missing in the account move line with label '%(move)s'."
msgstr ""
"Analitični pravilnik je nastavljen na 'Vedno' s kontom '%(account)s', a v "
"postavki temeljnice z oznako '%(move)s' manjka analitični konto."

#. module: account_analytic_required
#. odoo-python
#: code:addons/account_analytic_required/models/account_move_line.py:0
msgid ""
"Analytic policy is set to 'Never' with account '%(account)s' but the account"
" move line with label '%(move)s' has an analytic account "
"'%(analytic_account)s'."
msgstr ""
"Analitični pravilnik je za konto '%(account)s' nastavljen na 'Nikoli', "
"vendar ima postavka temeljnice z oznako '%(move)s' analitični konto '%"
"(analytic_account)s'."

#. module: account_analytic_required
#. odoo-python
#: code:addons/account_analytic_required/models/account_move_line.py:0
msgid ""
"Analytic policy is set to 'Posted moves' with account '%(account)s' but the "
"analytic account is missing in the account move line with label '%(move)s'."
msgstr ""
"Analitični pravilnik je nastavljen na 'Knjižene postavke' s kontom '%"
"(account)s', vendar analitični konto manjka v postavki temeljnice z oznako '%"
"(move)s'."

