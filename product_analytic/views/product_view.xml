<odoo>
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product_analytic.product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <group name="properties" position="after">
                <group name="analytic" string="Analytic">
                    <field name="analytic_distribution_model_ids">
                        <list open_form_view="True" editable="top">
                            <field name="sequence" widget="handle" />
                            <field name="prefix_placeholder" column_invisible="1" />
                            <field
                                name="account_prefix"
                                optional="show"
                                widget="char_with_placeholder_field"
                                options="{'placeholder_field': 'prefix_placeholder'}"
                            />
                            <field name="partner_id" optional="show" />
                            <field name="partner_category_id" optional="hide" />
                            <field name="product_id" readonly="True" />
                            <field name="product_categ_id" optional="hide" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                optional="show"
                            />
                            <field
                                name="analytic_distribution"
                                widget="analytic_distribution"
                                options="{'force_applicability': 'optional', 'disable_save': true}"
                            />
                        </list>
                    </field>
                </group>
            </group>
        </field>
    </record>
    <record id="view_category_property_form" model="ir.ui.view">
        <field name="name">product_analytic.product.categ.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="account.view_category_property_form" />
        <field name="arch" type="xml">
            <group name="account_property" position="after">
                <group name="analytic" string="Analytic">
                    <field name="analytic_distribution_model_ids">
                        <list open_form_view="True" editable="top">
                            <field name="sequence" widget="handle" />
                            <field name="prefix_placeholder" column_invisible="1" />
                            <field
                                name="account_prefix"
                                optional="show"
                                widget="char_with_placeholder_field"
                                options="{'placeholder_field': 'prefix_placeholder'}"
                            />
                            <field name="partner_id" optional="show" />
                            <field name="partner_category_id" optional="hide" />
                            <field name="product_id" optional="hide" />
                            <field name="product_categ_id" readonly="True" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                optional="show"
                            />
                            <field
                                name="analytic_distribution"
                                widget="analytic_distribution"
                                options="{'force_applicability': 'optional', 'disable_save': true}"
                            />
                        </list>
                    </field>
                </group>
            </group>
        </field>
    </record>
</odoo>
