<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_scrap_analytic_form" model="ir.ui.view">
        <field name="name">stock.scrap.move.analytic.form</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_scrap_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group[1]" position="inside">
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    groups="analytic.group_analytic_accounting"
                    options="{'product_field': 'product_id', 'business_domain': 'stock_move'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
